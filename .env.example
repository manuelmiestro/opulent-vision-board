# Everything is optional. With nothing set, the app runs in preview mode:
# data stays on the device, AI uses the on-device engine, and Premium can be previewed.

# --- Supabase: accounts + cross-device sync (run supabase/schema.sql first) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Lets the Stripe webhook record subscriptions.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 after enabling the Apple provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_APPLE=

# --- OpenAI: AI affirmations, milestone plans and insights ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Stripe: Premium subscriptions (use test keys first) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# From the webhook endpoint pointing at https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Optional: canonical URL used for Stripe redirects (defaults to the request origin).
NEXT_PUBLIC_APP_URL=
